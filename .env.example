# Copy to .env and uncomment the key for whichever provider config.yaml's models use.
# LiteLLM reads these standard variable names.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# 1 = use only the committed LLM cache (no network; a cache miss is an error).
LLM_OFFLINE=0

# Only needed to download the raw Kaggle dataset (make data).
# KAGGLE_USERNAME=
# KAGGLE_KEY=
